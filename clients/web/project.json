{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "clients/web",
  "projectType": "application",
  "implicitDependencies": ["bff"],
  "targets": {
    "gen-api": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make gen-api",
        "cwd": "clients/web"
      },
      "inputs": ["{workspaceRoot}/apis/bff/IF/**/*"],
      "outputs": ["{projectRoot}/src/api/generated/**/*"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make build",
        "cwd": "clients/web"
      },
      "inputs": ["production"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make dev",
        "cwd": "clients/web"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make test",
        "cwd": "clients/web"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make lint",
        "cwd": "clients/web"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make check",
        "cwd": "clients/web"
      }
    }
  }
}
